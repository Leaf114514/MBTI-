@import "../../common/index.wxss";

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--spacing-lg);
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-page);
  position: relative;
  overflow: hidden;
}

.page-content {
  width: 100%;
}

.section-gap {
  height: var(--spacing-lg);
}

/* ===== 配对计算器卡片 ===== */
.calc-card {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  border: 2rpx solid rgba(255, 107, 107, 0.3);
  box-shadow: var(--shadow-card);
  padding: var(--spacing-xl);
}

.calc-title {
  display: block;
  font-size: var(--font-size-subtitle);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-lg);
}

/* 选择器行 */
.selector-row {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: var(--spacing-md);
}

.type-slot {
  flex: 1;
  position: relative;
}

.type-slot-text {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background-color: var(--color-bg-input);
  border-radius: var(--radius-md);
  font-size: var(--font-size-body);
  color: var(--color-text-tertiary);
  letter-spacing: 4rpx;
}

.type-slot-text.has-value {
  color: var(--color-primary);
  font-weight: var(--font-weight-bold);
  background-color: rgba(255, 107, 107, 0.06);
  border: 1rpx solid var(--color-primary);
}

/* 连线 */
.pair-line {
  width: 40rpx;
  height: 4rpx;
  background-color: rgba(255, 107, 107, 0.6);
  flex-shrink: 0;
  margin-top: 40rpx;
}

/* 展开区域（复用答题页动画） */
.picker-expand {
  overflow: hidden;
  position: absolute;
  left: 0;
  right: 0;
  top: 88rpx;
  z-index: 10;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
}

.picker-expand.anim-in {
  animation: expand-in 0.26s var(--ease-out) both;
}

.picker-expand.anim-out {
  animation: expand-out 0.26s var(--ease-out) both;
}

@keyframes expand-in {
  from { max-height: 0; opacity: 0; }
  to { max-height: 500rpx; opacity: 1; }
}

@keyframes expand-out {
  from { max-height: 500rpx; opacity: 1; }
  to { max-height: 0; opacity: 0; }
}

.picker-wheels {
  border-radius: var(--radius-md);
  background-color: var(--color-bg-input);
  margin: var(--spacing-sm);
}

.calc-picker-view {
  width: 100%;
  height: 260rpx;
}

.picker-indicator {
  height: 70rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 70rpx;
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
}

.picker-confirm-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin: 0 var(--spacing-sm) var(--spacing-sm);
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  color: var(--color-text-inverse);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-sm);
}

/* ===== 结果区域 ===== */
.result-card {
  margin-top: var(--spacing-lg);
  padding-top: var(--spacing-md);
  border-top: 1rpx solid var(--color-divider);
}

.score-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}

.score-label {
  width: 60rpx;
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.score-bar {
  flex: 1;
  height: 12rpx;
  background-color: var(--color-bg-input);
  border-radius: 6rpx;
  overflow: hidden;
}

.score-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width var(--duration-normal) var(--ease-out);
}

.score-fill.friendship {
  background-color: var(--color-accent-teal);
}

.score-fill.romance {
  background-color: var(--color-accent-purple);
}

.score-fill.work {
  background-color: var(--color-accent-yellow);
}

.score-num {
  width: 60rpx;
  text-align: right;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  flex-shrink: 0;
}

/* AI 评语 */
.comment-area {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  background-color: var(--color-bg-input);
  border-radius: var(--radius-md);
  min-height: 60rpx;
}

.comment-text {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-normal);
}

.comment-loading {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

/* 换一组 */
.try-another {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin-top: var(--spacing-md);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
}

.try-another:active {
  background-color: var(--color-bg-input);
}
