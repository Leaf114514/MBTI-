@import "../../common/index.wxss";

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--spacing-lg);
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-page);
  position: relative;
  overflow: hidden;
}

.page-content {
  width: 100%;
  height: calc(100vh - var(--spacing-lg) * 2 - 130rpx - env(safe-area-inset-bottom));
  position: relative;
}

/* ===== 签语卡片区域 ===== */
.fortune-section {
  height: 80%;
  display: flex;
  align-items: stretch;
  justify-content: center;
}

/* ===== 翻牌容器 ===== */
.card-flip-wrap {
  width: 100%;
  height: 100%;
  perspective: 1200rpx;
}

.card-flipper {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 1.04s cubic-bezier(0.4, 0, 0.2, 1);
}

.card-flipper.flipped {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* ===== 卡背 ===== */
.card-back-face {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  border-radius: var(--radius-lg);
  background: linear-gradient(180deg, #3D1A2E 0%, #2B1424 40%, #3D1A2E 100%);
  border: 2rpx solid rgba(255, 107, 107, 0.25);
  box-shadow: 0 4rpx 32rpx rgba(61, 26, 46, 0.4);
  overflow: hidden;
  padding: var(--spacing-xl) 0;
}

/* 顶/底半圆拱门 */
.back-arch {
  width: 240rpx;
  height: 120rpx;
  position: relative;
}

.back-arch-top {
  border-radius: 240rpx 240rpx 0 0;
  border: 2rpx solid rgba(255, 107, 107, 0.15);
  border-bottom: none;
}

.back-arch-bottom {
  border-radius: 0 0 240rpx 240rpx;
  border: 2rpx solid rgba(255, 107, 107, 0.15);
  border-top: none;
}

.arch-ring {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 0;
  border: 1rpx dashed rgba(255, 107, 107, 0.1);
}

.back-arch-top .arch-ring {
  border-radius: 216rpx 216rpx 0 0;
  border-bottom: none;
}

.back-arch-bottom .arch-ring {
  top: 0;
  bottom: 12rpx;
  border-radius: 0 0 216rpx 216rpx;
  border-top: none;
}

/* 中央水印 */
.back-mandala {
  font-size: 88rpx;
  font-weight: var(--font-weight-bold);
  color: rgba(255, 107, 107, 0.1);
  letter-spacing: 14rpx;
}

/* 随机棱星 */
.back-spark {
  position: absolute;
  color: rgba(255, 160, 160, 0.18);
  pointer-events: none;
}

/* 提示文字 */
.back-hint {
  font-size: var(--font-size-body);
  color: rgba(255, 180, 180, 0.35);
  letter-spacing: 8rpx;
}

/* ===== 卡正面 ===== */
.card-front-face {
  transform: rotateY(180deg);
}

/* ===== 配对计算器浮动气泡 ===== */
.calc-drawer {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 85%;
  z-index: 10;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-xl);
  border: 2rpx solid rgba(255, 107, 107, 0.3);
  box-shadow: var(--shadow-card);
  transition: width 0.3s var(--ease-out);
}

.calc-drawer.expanded {
  width: 95%;
}

.calc-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
}

.calc-trigger-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  letter-spacing: 2rpx;
}

.calc-trigger:active {
  background-color: rgba(255, 107, 107, 0.04);
}

.calc-body {
  padding: 0 var(--spacing-xl) var(--spacing-xl);
  animation: drawer-body-in 0.3s var(--ease-out) both;
}

@keyframes drawer-body-in {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== 配对计算器卡片 ===== */
.calc-card {
  background-color: transparent;
}

.calc-title {
  display: block;
  font-size: var(--font-size-subtitle);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-lg);
}

/* 选择器行 */
.selector-row {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: var(--spacing-md);
}

.type-slot {
  flex: 1;
  position: relative;
}

.type-slot-text {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background-color: var(--color-bg-input);
  border-radius: var(--radius-md);
  font-size: var(--font-size-body);
  color: var(--color-text-tertiary);
  letter-spacing: 4rpx;
}

.type-slot-text.has-value {
  color: var(--color-primary);
  font-weight: var(--font-weight-bold);
  background-color: rgba(255, 107, 107, 0.06);
  border: 1rpx solid var(--color-primary);
}

/* 连线 */
.pair-line {
  width: 40rpx;
  height: 4rpx;
  background-color: rgba(255, 107, 107, 0.6);
  flex-shrink: 0;
  margin-top: 40rpx;
}

/* 内联两步选择器 */
.inline-picker {
  margin-top: var(--spacing-md);
  animation: drawer-body-in 0.2s var(--ease-out) both;
}

.picker-row {
  display: flex;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}

.picker-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-caption);
  letter-spacing: 2rpx;
  transition: all 0.15s ease;
}

.picker-btn:active {
  opacity: 0.7;
}

/* 第一行 - 能量方向 (珊瑚红系) */
.picker-btn-head {
  background-color: rgba(255, 107, 107, 0.06);
  color: var(--color-text-secondary);
}

.picker-btn-head.active {
  background-color: rgba(255, 107, 107, 0.15);
  color: var(--color-primary);
  font-weight: var(--font-weight-bold);
  border: 1rpx solid var(--color-primary);
}

/* 第二行 - 认知功能 (紫色系) */
.picker-btn-tail {
  background-color: rgba(167, 139, 250, 0.06);
  color: var(--color-text-secondary);
}

.picker-btn-tail.active {
  background-color: rgba(167, 139, 250, 0.15);
  color: var(--color-accent-purple);
  font-weight: var(--font-weight-bold);
  border: 1rpx solid var(--color-accent-purple);
}

/* 确认按钮 */
.picker-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin-top: var(--spacing-sm);
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  color: var(--color-text-inverse);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-medium);
  letter-spacing: 2rpx;
  border-radius: var(--radius-md);
}

.picker-confirm:active {
  opacity: 0.85;
}

/* ===== 结果区域 ===== */
.result-card {
  margin-top: var(--spacing-lg);
  padding-top: var(--spacing-md);
  border-top: 1rpx solid var(--color-divider);
}

.score-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}

.score-label {
  width: 60rpx;
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.score-bar {
  flex: 1;
  height: 12rpx;
  background-color: var(--color-bg-input);
  border-radius: 6rpx;
  overflow: hidden;
}

.score-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width var(--duration-normal) var(--ease-out);
}

.score-fill.friendship {
  background-color: var(--color-accent-teal);
}

.score-fill.romance {
  background-color: var(--color-accent-purple);
}

.score-fill.work {
  background-color: var(--color-accent-yellow);
}

.score-num {
  width: 60rpx;
  text-align: right;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  flex-shrink: 0;
}

/* AI 评语 */
.comment-area {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  background-color: var(--color-bg-input);
  border-radius: var(--radius-md);
  min-height: 60rpx;
}

.comment-text {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-normal);
}

.comment-loading {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

/* 换一组 */
.try-another {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin-top: var(--spacing-md);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
}

.try-another:active {
  background-color: var(--color-bg-input);
}
