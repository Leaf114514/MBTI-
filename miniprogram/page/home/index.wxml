<view class="container {{pageAnim}}">
  <view class="page-content">
    <!-- 每日签语卡片 -->
    <fortune-card
      mbtiType="{{userMbti}}"
      bind:typeTap="onFortuneTypeTap"
      bind:shareTap="onShareFortune"
    />

    <view class="section-gap"></view>

    <!-- MBTI 配对计算器 -->
    <view class="calc-card">
      <text class="calc-title">MBTI 配对计算器</text>

      <!-- 选择器行 -->
      <view class="selector-row">
        <!-- 左侧类型 -->
        <view class="type-slot" bindtap="onToggleLeftPicker">
          <text class="type-slot-text {{leftType ? 'has-value' : ''}}">{{leftType || '选择'}}</text>
          <view class="picker-expand {{leftHiding ? 'anim-out' : 'anim-in'}}" wx:if="{{leftSelecting || leftHiding}}" catchtap="noop">
            <view class="picker-wheels">
              <picker-view class="calc-picker-view" indicator-class="picker-indicator" value="{{leftPickerValue}}" bindchange="onLeftPickerChange">
                <picker-view-column>
                  <view wx:for="{{MBTI_HEAD}}" wx:key="*this" class="picker-item">{{item}}</view>
                </picker-view-column>
                <picker-view-column>
                  <view wx:for="{{MBTI_TAIL}}" wx:key="*this" class="picker-item">{{item}}</view>
                </picker-view-column>
              </picker-view>
            </view>
            <view class="picker-confirm-btn" catchtap="onConfirmLeft">
              <text>确认</text>
            </view>
          </view>
        </view>

        <!-- 心形 -->
        <view class="heart-icon">
          <view class="heart"></view>
        </view>

        <!-- 右侧类型 -->
        <view class="type-slot" bindtap="onToggleRightPicker">
          <text class="type-slot-text {{rightType ? 'has-value' : ''}}">{{rightType || '选择'}}</text>
          <view class="picker-expand {{rightHiding ? 'anim-out' : 'anim-in'}}" wx:if="{{rightSelecting || rightHiding}}" catchtap="noop">
            <view class="picker-wheels">
              <picker-view class="calc-picker-view" indicator-class="picker-indicator" value="{{rightPickerValue}}" bindchange="onRightPickerChange">
                <picker-view-column>
                  <view wx:for="{{MBTI_HEAD}}" wx:key="*this" class="picker-item">{{item}}</view>
                </picker-view-column>
                <picker-view-column>
                  <view wx:for="{{MBTI_TAIL}}" wx:key="*this" class="picker-item">{{item}}</view>
                </picker-view-column>
              </picker-view>
            </view>
            <view class="picker-confirm-btn" catchtap="onConfirmRight">
              <text>确认</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 结果卡片 -->
      <view class="result-card" wx:if="{{resultScores}}">
        <view class="score-row">
          <text class="score-label">友情</text>
          <view class="score-bar">
            <view class="score-fill friendship" style="width: {{resultScores.friendship}}%"></view>
          </view>
          <text class="score-num">{{resultScores.friendship}}</text>
        </view>
        <view class="score-row">
          <text class="score-label">恋爱</text>
          <view class="score-bar">
            <view class="score-fill romance" style="width: {{resultScores.romance}}%"></view>
          </view>
          <text class="score-num">{{resultScores.romance}}</text>
        </view>
        <view class="score-row">
          <text class="score-label">工作</text>
          <view class="score-bar">
            <view class="score-fill work" style="width: {{resultScores.work}}%"></view>
          </view>
          <text class="score-num">{{resultScores.work}}</text>
        </view>

        <!-- AI 评语 -->
        <view class="comment-area">
          <text class="comment-text" wx:if="{{!commentLoading && aiComment}}">{{aiComment}}</text>
          <text class="comment-loading" wx:elif="{{commentLoading}}">AI 正在分析...</text>
        </view>
      </view>

      <!-- 换一组 -->
      <view class="try-another" bindtap="onTryAnother" wx:if="{{resultScores}}">
        <text>换一组</text>
      </view>
    </view>
  </view>
</view>
