<!--
  ========================================
  故事阅读页（Story）
  功能：分页展示 AI 生成的故事全文，支持性格分析展开 + 续写入口
  核心机制：
    · swiper 分页 — 每轮故事（round）独立一页，左右滑动切换
    · scroll-view — 单页内上下滚动阅读正文
    · 性格分析气泡 — 点击分割线上的红色气泡展开/折叠 MBTI 解析内容
  状态流转：isLoading → 加载 / hasError → 错误 / else → 故事
  ========================================
-->
<view class="page-container {{darkTheme ? 'page-dark' : ''}}" style="--color-primary:{{themeColor}};--color-primary-rgb:{{themeColorRgb}}">
  <!-- ================================================================== -->
  <!-- 加载态：双进度条 + 弹跳点 + 文案                                       -->
  <!-- ================================================================== -->
  <view class="loading-container" wx:if="{{isLoading}}">
    <!-- 左侧进度条 -->
    <view class="loading-progress-bar left-bar">
      <view class="loading-progress-fill" style="height: {{loadingProgress}}%;"></view>
    </view>
    <!-- 右侧进度条 -->
    <view class="loading-progress-bar right-bar">
      <view class="loading-progress-fill" style="height: {{loadingProgress}}%;"></view>
    </view>
    <!-- 三点弹跳动画 -->
    <view class="loading-animation">
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
    </view>
    <text class="loading-text">{{loadingText}}</text>
    <text class="loading-hint">AI 创作需要一点时间，请耐心等待</text>
  </view>

  <!-- ================================================================== -->
  <!-- 错误态：大号 ERROR + 错误提示 + 点击返回                                -->
  <!-- ================================================================== -->
  <view class="error-container" wx:elif="{{hasError}}" bindtap="goBack">
    <text class="error-title">ERROR</text>
    <text class="error-msg">{{errorMsg}}</text>
    <text class="error-hint">点击任意位置返回</text>
  </view>

  <!-- ================================================================== -->
  <!-- 故事正文                                                              -->
  <!-- ================================================================== -->
  <view class="story-content" wx:else>
    <!-- ----- 自定义固定导航栏 ----- -->
    <view class="fixed-header" style="padding-top: {{statusBarHeight}}px;">
      <!-- 第一行：圆形首页按钮 -->
      <view class="header-top-row">
        <view class="home-btn" bindtap="goHome">
          <image class="home-icon" src="/image/主页.svg" mode="aspectFit" />
        </view>
      </view>
      <!-- 第二行：故事标题 + 页码/历史徽章 -->
      <view class="header-title-row">
        <text class="story-title">{{storyTitle}}</text>
        <!-- 页码徽章：显示当前页/总页数 -->
        <view class="round-count-badge">
          <text>页数:{{currentRoundIndex + 1}}/{{storyRounds.length}}</text>
        </view>
        <!-- 历史按钮（二次确认防误触） -->
        <view class="header-badge {{historyConfirming ? 'shaking' : ''}}" bindtap="goHistory">
          <text>{{historyConfirming ? '确认' : '历史'}}</text>
        </view>
      </view>
      <view class="header-divider"></view>
    </view>

    <!-- ----- 右侧阅读进度条（随 scroll 事件更新） ----- -->
    <view class="scroll-progress" style="top: {{progressTop}}px; bottom: {{progressBottom}}px;">
      <view class="scroll-progress-fill" style="height: {{scrollProgress * 100}}%;"></view>
    </view>

    <!-- ----- swiper 分页：每轮故事独立一页 ----- -->
    <swiper
      class="story-swiper"
      current="{{currentRoundIndex}}"
      bindchange="onRoundChange"
    >
      <swiper-item wx:for="{{storyRounds}}" wx:key="index">
        <!-- scroll-view 接管单页内的垂直滚动 -->
        <scroll-view
          scroll-y
          enhanced
          show-scrollbar="{{false}}"
          class="story-scroll"
          bindscroll="onScroll"
        >
          <!-- 顶部留白（避开固定导航栏高度） -->
          <view style="height: {{navBarHeight}}px;"></view>

          <!-- 故事正文卡片 -->
          <view class="story-body">
            <!--
              遍历 segments 混合渲染正文段落和性格分析气泡
              每段 seg 的类型：
                type='text'       → 普通正文（首行缩进两格）
                type='annotation' → 性格分析气泡（点击展开/折叠）
            -->
            <block wx:for="{{item.segments}}" wx:for-item="seg" wx:key="segIdx" wx:for-index="segIdx">
              <!-- 正文段落 -->
              <view class="story-text {{seg.beforeAnnotation ? 'before-annotation' : ''}}" wx:if="{{seg.type === 'text'}}">
                <text>{{seg.content}}</text>
              </view>
              <!-- 性格分析气泡 -->
              <view class="annotation-wrapper" wx:if="{{seg.type === 'annotation'}}"
                bindtap="toggleAnnotation"
                data-round-index="{{index}}"
                data-seg-index="{{segIdx}}">
                <!-- 分割线 + 红色方角气泡（三角形指示展开方向） -->
                <view class="annotation-divider-row">
                  <view class="divider-line"></view>
                  <view class="annotation-bubble">
                    <view class="bubble-triangle {{seg.expanded ? 'up' : 'down'}}"></view>
                  </view>
                  <view class="divider-line"></view>
                </view>
                <!-- 展开后的分析内容（弹簧动画） -->
                <view class="annotation-expand-wrapper {{seg.expanded ? 'expanded' : ''}}">
                  <view class="annotation-expand-content">
                    <text>{{seg.content}}</text>
                  </view>
                </view>
              </view>
            </block>
          </view>

          <!-- 底部留白（避开操作栏高度） -->
          <view style="height: {{progressBottom + 20}}px;"></view>
        </scroll-view>
      </swiper-item>
    </swiper>

    <!-- ----- 页码指示器（多页时悬浮显示） ----- -->
    <view class="round-indicator" wx:if="{{storyRounds.length > 1}}">
      <text>第 {{currentRoundIndex + 1}} 页 / 共 {{storyRounds.length}} 页</text>
    </view>

    <!-- ----- 底部固定操作栏 ----- -->
    <view class="action-bar">
      <!-- 返回按钮（红色描边白底，二次确认防误触） -->
      <view class="action-button btn-outline {{backConfirming ? 'shaking' : ''}}" bindtap="goBack">
        <text>{{backConfirming ? '确认返回？' : '返回'}}</text>
      </view>
      <!-- 续写按钮（红色实底，仅当 canContinue 时显示） -->
      <view class="action-button btn-solid {{continueConfirming ? 'shaking' : ''}}" bindtap="goContinue" wx:if="{{canContinue}}">
        <text>{{continueConfirming ? '为此篇续写？' : '续写'}}</text>
      </view>
    </view>
  </view>
</view>
