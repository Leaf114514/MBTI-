@import "../../common/index.wxss";

.container {
  min-height: 100vh;
  background-color: var(--color-bg-page);
  padding: var(--spacing-lg);
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
  position: relative;
  overflow: hidden;
}

/* shape 掉落、toggle-btn 切换按钮、expand 动画 —— 已移至 common/index.wxss */

/* ===== 卡片通用 ===== */
.profile-card {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: var(--spacing-xl);
  position: relative;
  overflow: hidden;
}

.card-title {
  display: block;
  font-size: var(--font-size-subtitle);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-md);
}

/* ===== MBTI 选择器 ===== */
.mbti-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background-color: var(--color-bg-input);
  border-radius: var(--radius-md);
}

.mbti-selector:active {
  background-color: var(--color-border);
}

.mbti-display {
  font-size: var(--font-size-body);
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
}

.mbti-display.has-value {
  font-size: var(--font-size-subtitle);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
  letter-spacing: 6rpx;
}

/* 展开区域 —— expand-in/out keyframes 已移至 common */
.picker-expand {
  overflow: hidden;
  margin-top: var(--spacing-md);
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
}

.picker-expand.anim-in {
  animation: expand-in 0.26s var(--ease-out) both;
}

.picker-expand.anim-out {
  animation: expand-out 0.26s var(--ease-out) both;
}

.picker-wheels {
  border-radius: var(--radius-md);
  background-color: var(--color-bg-input);
}

.mbti-picker-view {
  width: 100%;
  height: 300rpx;
}

.picker-indicator {
  height: 80rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
}

.picker-confirm-btn {
  margin: var(--spacing-sm); /* 该页与 mbti 页 margin 不同：profile 用四周，mbti 用 margin-top */
  height: 72rpx;
}

/* 类型描述 */
.mbti-desc {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  background-color: var(--color-bg-input);
  border-radius: var(--radius-md);
}

.desc-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  line-height: var(--line-height-normal);
}

/* ===== 快捷入口 ===== */
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
}

.menu-arrow {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}
