@import '../../common/index.wxss';

.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl);
  background-color: var(--color-bg-page);
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* shape 掉落图形、toggle-btn 切换按钮 —— 已移至 common/index.wxss */

/* 登录页左上角按钮下移，避开自定义导航栏 */
.login-page .toggle-btn {
  top: 120rpx;
}

/* ===== 自定义导航栏 ===== */
.custom-nav {
  width: 100%;
  position: relative;
  z-index: 10;
}

.custom-nav-bar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-nav-title {
  font-size: 17px;
  font-weight: bold;
  color: #FF6B6B;
}

/* ===== 标题 ===== */
.login-title {
  margin-top: 22vh;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-lg);
  z-index: 1;
}

.title-text {
  font-size: 80rpx;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: 12rpx;
  -webkit-text-stroke: 1rpx #FF6B6B;
  text-shadow: 0 0 12rpx #FF6B6B, 0 0 24rpx #FF6B6B;
}

/* ===== 分割线 ===== */
.title-divider {
  width: 75%;
  height: 4rpx;
  background-color: #FF6B6B;
  border-radius: 2rpx;
  margin-bottom: 10rpx;
  z-index: 1;
}

/* ===== 标语 ===== */
.login-slogan {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-regular);
  color: var(--color-text-secondary);
  line-height: var(--line-height-relaxed);
  text-align: center;
  margin-bottom: var(--spacing-3xl);
  z-index: 1;
}

/* ===== 登录按钮 ===== */
.login-btn {
  width: 80% !important;
  max-width: 480rpx;
  height: 96rpx !important;
  line-height: 96rpx !important;
  padding: 0 !important;
  border: none !important;
  border-radius: 48rpx !important;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E) !important;
  color: #FFFFFF !important;
  font-size: var(--font-size-subtitle) !important;
  font-weight: var(--font-weight-bold) !important;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
  transition: opacity var(--duration-normal) var(--ease-out);
  z-index: 1;
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  opacity: 1 !important;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E) !important;
  color: #FFFFFF !important;
}

/* 登录按钮专属抖动（幅度比通用版大） */
.login-btn-shake {
  animation: btn-shake 0.5s ease-in-out;
}
