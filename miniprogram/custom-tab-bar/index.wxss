.tab-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 100rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #e5e5e5;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0;
}

.icon-wrapper {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  position: absolute;
  top: 0;
  left: 0;
}

.tab-icon-colored {
  clip-path: inset(0 0 0 0);
  transition: clip-path 0.35s ease;
}

.icon-filled {
  clip-path: inset(0 0 0 0);
}

.icon-drained {
  clip-path: inset(100% 0 0 0);
}

.tab-text {
  font-size: 20rpx;
  margin-top: 4rpx;
  line-height: 1;
}
