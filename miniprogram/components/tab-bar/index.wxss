.tab-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 100rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #e5e5e5;
  padding-bottom: env(safe-area-inset-bottom);
  transition: background-color 0.3s ease, border-color 0.3s ease;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

/* 暗色模式 */
.tab-bar.dark-mode {
  background-color: #1E1E2A;
  border-top-color: rgba(255, 255, 255, 0.08);
}

.tab-bar.dark-mode .tab-text {
  color: rgba(255, 255, 255, 0.5) !important;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0;
}

.icon-wrapper {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  position: absolute;
  top: 0;
  left: 0;
}

.tab-icon-colored {
  clip-path: inset(0 0 0 0);
  transition: clip-path 0.35s ease;
}

.icon-filled {
  clip-path: inset(0 0 0 0);
}

.icon-drained {
  clip-path: inset(100% 0 0 0);
}

.tab-text {
  font-size: 20rpx;
  margin-top: 4rpx;
  line-height: 1;
}
