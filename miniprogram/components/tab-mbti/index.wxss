@import "../../common/index.wxss";

/* ===== 页面根容器 ===== */
.tab-mbti-root {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #FFFBFB 0%, #FFF5F5 100%);
  transition: background 0.3s ease;
}

.tab-mbti-root.page-dark {
  background: #1A1A28;
}

/* ===== 页面标题区域 ===== */
.header-section {
  padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-md);
}

.title-row {
  display: flex;
  align-items: center;
}

.page-title {
  font-size: calc(var(--font-size-hero) * 1.2);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-xs);
}

.title-divider {
  height: 2rpx;
  background-color: var(--color-primary);
  margin-top: var(--spacing-xs);
  margin-bottom: var(--spacing-xs);
}

.page-subtitle {
  display: block;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  line-height: var(--line-height-normal);
}

.history-entry {
  display: inline-flex;
  align-items: center;
  margin-left: auto;
  padding: var(--spacing-xs) var(--spacing-sm);
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.history-text {
  font-size: var(--font-size-caption);
  color: var(--color-primary);
}



/* ===== 选择器区域 ===== */
.selector-section {
  padding: 0 var(--spacing-lg);
  padding-bottom: 200rpx;
}

.selector-card {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-card);
}

/* ===== 选择器行布局（标签左 / 显示右） ===== */
.selector-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.selector-label {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  white-space: nowrap;
}

.picker-display {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  padding: var(--spacing-xs) var(--spacing-md);
  background-color: var(--color-bg-input);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-body);
  color: var(--color-text-tertiary);
}

.picker-display.has-value {
  color: var(--color-text-primary);
}

/* 展开区域（滚轮 + 确认按钮）高度动画 —— expand-in/out keyframes 已移至 common */
.picker-expand {
  overflow: hidden;
}

.picker-expand.anim-in {
  animation: expand-in 0.26s var(--ease-out) both;
}

.picker-expand.anim-out {
  animation: expand-out 0.26s var(--ease-out) both;
}

/* ===== 滚轮 ===== */
.picker-wheels {
  margin-top: var(--spacing-sm);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-input);
}

.mbti-picker-view {
  width: 100%;
  height: 300rpx;
}

.gender-picker-view {
  width: 100%;
  height: 200rpx;
}

/* ===== 性别选项按钮 ===== */
.gender-options {
  display: flex;
  gap: var(--spacing-md);
  margin-top: var(--spacing-md);
}

.gender-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background-color: var(--color-bg-input);
  border: 2rpx solid transparent;
  border-radius: var(--radius-md);
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  transition: all var(--duration-fast) var(--ease-out);
}

.gender-option.selected {
  background-color: rgba(231, 76, 60, 0.1);
  border-color: var(--color-primary);
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.gender-option:active {
  transform: scale(0.96);
}

.picker-indicator {
  height: 80rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
}

/* ===== 确认按钮 —— 基类已移至 common，仅覆盖该页特有的 margin */
.picker-confirm-btn {
  margin-top: var(--spacing-sm);
  height: 72rpx;
}

.picker-confirm-btn:active {
  opacity: 0.9;
}

/* ===== 通用按钮 ===== */
.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 var(--spacing-lg);
  background-color: var(--color-bg-card);
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-md);
}

.btn-secondary:active {
  background-color: rgba(231, 76, 60, 0.1);
}

.start-btn {
  position: fixed;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  left: var(--spacing-lg);
  right: var(--spacing-lg);
  z-index: 100;
}



/* ===== 答题区域 ===== */
.quiz-section {
  padding: 0 var(--spacing-lg);
  padding-bottom: 200rpx;
}

/* 进度条 */
.progress-bar-container {
  margin-bottom: var(--spacing-lg);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-xs);
}

.progress-text {
  font-size: var(--font-size-subtitle);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
}

.progress-percent {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  font-weight: var(--font-weight-regular);
}

.progress-bar {
  height: 8rpx;
  background-color: var(--color-bg-input);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light));
  border-radius: 4rpx;
  transition: width var(--duration-normal) var(--ease-out);
}

/* 题目卡片 */
.question-card {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl);
  box-shadow: var(--shadow-card);
}

.question-text {
  display: block;
  font-size: var(--font-size-subtitle);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-relaxed);
  margin-bottom: var(--spacing-xl);
}

/* 选项列表 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.option-card {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  background-color: var(--color-bg-page);
  border: 2rpx solid transparent;
  border-radius: var(--radius-md);
  transition: all var(--duration-fast) var(--ease-out);
}

.option-card:active {
  transform: scale(0.98);
}

.option-card.selected {
  background-color: rgba(255, 107, 107, 0.08);
  border-color: var(--color-primary);
}

.option-key {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-full);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-secondary);
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.option-card.selected .option-key {
  background-color: var(--color-primary);
  color: var(--color-text-inverse);
}

.option-text {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-normal);
}

/* 底部操作 */
.quiz-actions {
  position: fixed;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  left: var(--spacing-lg);
  right: var(--spacing-lg);
  z-index: 100;
  display: flex;
  gap: 20rpx;
  background-color: var(--color-bg-page);
  padding: var(--spacing-md) 0 0;
}

/* 上一题 / 下一题 / 提交 按钮等宽 */
.quiz-btn {
  flex: 1;
}

/* 下一题 / 提交按钮高度与上一题一致 */
.quiz-actions .btn-primary {
  height: 80rpx;
}

/* 取消答题确认态（红色） */
.btn-danger {
  background-color: var(--color-primary) !important;
  color: var(--color-text-inverse) !important;
}

.btn-danger:active {
  opacity: 0.9;
}

/* 按钮未满足条件态：半透明但仍可点击（用于触发提示） */
.btn-warn {
  opacity: 0.5;
}

/* 抖动动画 —— btn-shake keyframes 和 .anim-shake 已移至 common */

/* ===== "查看故事"按钮样式 ===== */
.btn-story {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.anim-story-btn-in {
  animation: story-btn-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes story-btn-in {
  0% {
    transform: scale(0.8);
    opacity: 0;
    background: #f5f5f5;
  }
  60% {
    transform: scale(1.05);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* ===== 页面转场动画 ===== */

/* 选择器卡片 / 按钮掉落出屏幕（select → quiz） */
.anim-fall-out {
  animation: fall-out var(--fall-dur, 0.5s) ease-in forwards;
}

@keyframes fall-out {
  from { opacity: 1; transform: translateY(0); }
  to { opacity: 0; transform: translateY(800rpx); }
}

/* 选择器卡片从下方升起入场（quiz → select） */
.anim-rise-in {
  animation: rise-in 0.45s var(--ease-spring) both;
}

@keyframes rise-in {
  from { opacity: 0; transform: translateY(300rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 题目卡片从上方落下入场（select → quiz） */
.anim-drop-in {
  animation: drop-in 0.5s var(--ease-spring) both;
}

@keyframes drop-in {
  from { opacity: 0; transform: translateY(-600rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 题目卡片向上升起消失（quiz → select） */
.anim-rise-out {
  animation: rise-out 0.4s ease-in forwards;
}

@keyframes rise-out {
  from { opacity: 1; transform: translateY(0); }
  to { opacity: 0; transform: translateY(-600rpx); }
}

/* 通用淡入 / 淡出 */
.anim-hidden {
  opacity: 0;
}

.anim-fade-in {
  animation: fade-in-anim 0.3s ease-out both;
}

.anim-fade-out {
  animation: fade-in-anim 0.25s ease-in reverse both;
}

@keyframes fade-in-anim {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ===== 题目翻页动画（左右滑动） ===== */

/* 下一题：当前卡片向左滑出 */
.anim-flip-out-left {
  animation: flip-out-left 0.22s ease-in forwards;
}

@keyframes flip-out-left {
  from { transform: translateX(0); opacity: 1; }
  to { transform: translateX(-100%); opacity: 0; }
}

/* 下一题：新卡片从右滑入 */
.anim-flip-in-right {
  animation: flip-in-right 0.25s var(--ease-out) both;
}

@keyframes flip-in-right {
  from { transform: translateX(100%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

/* 上一题：当前卡片向右滑出 */
.anim-flip-out-right {
  animation: flip-out-right 0.22s ease-in forwards;
}

@keyframes flip-out-right {
  from { transform: translateX(0); opacity: 1; }
  to { transform: translateX(100%); opacity: 0; }
}

/* 上一题：新卡片从左滑入 */
.anim-flip-in-left {
  animation: flip-in-left 0.25s var(--ease-out) both;
}

@keyframes flip-in-left {
  from { transform: translateX(-100%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

/* ===== 故事结果阶段 ===== */
.result-section {
  padding: 0 var(--spacing-lg);
  padding-bottom: 200rpx;
}

.result-card {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl);
  box-shadow: var(--shadow-card);
}

.result-title {
  display: block;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: var(--spacing-sm);
}

.result-meta {
  display: flex;
  justify-content: center;
  margin-bottom: var(--spacing-md);
}

.result-word-count {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

.result-divider {
  height: 2rpx;
  background-color: var(--color-divider);
  margin-bottom: var(--spacing-lg);
}

.result-scroll {
  max-height: 55vh;
}

.result-content {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-relaxed);
  white-space: pre-wrap;
  word-break: break-all;
}

.result-actions {
  position: fixed;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  left: var(--spacing-lg);
  right: var(--spacing-lg);
  z-index: 100;
  display: flex;
  gap: 20rpx;
}

.result-btn {
  flex: 1;
}
