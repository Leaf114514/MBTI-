<view class="fortune-card" style="--accent: {{accentColor}}; --ar: {{accentRgb}};">
  <!-- 四角装饰 -->
  <view class="card-corner corner-tl"></view>
  <view class="card-corner corner-tr"></view>
  <view class="card-corner corner-bl"></view>
  <view class="card-corner corner-br"></view>

  <!-- 已选类型 -->
  <block wx:if="{{!showPrompt}}">
    <!-- 牌名区 -->
    <view class="card-title-area" bindtap="onTypeTap">
      <text class="card-name">{{mbtiType}}</text>
      <text class="card-number">{{dateNum}}</text>
      <!-- 幸运色 -->
      <view class="card-lucky" wx:if="{{luckyColor}}">
        <view class="lucky-dot" style="background-color: {{luckyColor.hex}};"></view>
        <text class="lucky-name">{{luckyColor.name}}</text>
      </view>
    </view>

    <!-- 加载失败 -->
    <block wx:if="{{loadError}}">
      <view class="card-center">
        <text class="fortune-message fortune-error-text">签语加载失败，请稍后重试</text>
      </view>
      <view class="fortune-share" bindtap="onRetry">
        <text>重新加载</text>
      </view>
    </block>

    <!-- 签语内容 -->
    <block wx:elif="{{message}}">
      <view class="card-center">
        <!-- 装饰曼陀罗 -->
        <view class="card-mandala">
          <view class="mandala-outer"></view>
          <view class="mandala-ring"></view>
          <view class="mandala-inner"></view>
          <view class="mandala-cross"></view>
          <text class="mandala-type">{{mbtiType}}</text>
        </view>
        <!-- 正文 -->
        <view class="fortune-message-wrap">
          <text class="fortune-quote-left">「</text>
          <text class="fortune-message">{{message}}</text>
          <text class="fortune-quote-right">」</text>
        </view>
      </view>

      <!-- 底部解读区 -->
      <view class="card-bottom">
        <!-- 关键词居中 -->
        <view class="card-keywords">
          <text class="keyword-tag" wx:for="{{keywords}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="fortune-divider">✦</view>
        <view class="fortune-share" bindtap="onShare">
          <text>分享给朋友</text>
        </view>
      </view>
    </block>
  </block>

  <!-- 牌背（未选类型） -->
  <block wx:else>
    <view class="card-back">
      <view class="card-back-pattern">
        <view class="back-ring"></view>
        <view class="back-ring-inner"></view>
        <text class="back-symbol">?</text>
      </view>
      <text class="card-back-text">翻转你的命运之牌</text>
      <view class="prompt-btn" bindtap="onGoSelect">
        <text>前往选择</text>
      </view>
    </view>
  </block>

  <!-- Loading -->
  <view class="fortune-loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
