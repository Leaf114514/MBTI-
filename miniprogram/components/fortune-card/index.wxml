<view class="fortune-card">
  <!-- 日期行 -->
  <view class="fortune-date">
    <text class="fortune-date-text">{{dateStr}}</text>
    <text class="fortune-weekday">{{weekday}}</text>
  </view>

  <!-- 已选类型 -->
  <block wx:if="{{!showPrompt}}">
    <!-- MBTI 徽章 -->
    <view class="fortune-type" bindtap="onTypeTap">
      <text class="fortune-type-text">{{mbtiType}}</text>
    </view>

    <!-- 签语内容 -->
    <view class="fortune-message-wrap">
      <text class="fortune-quote-left">「</text>
      <text class="fortune-message">{{message}}</text>
      <text class="fortune-quote-right">」</text>
    </view>

    <!-- 幸运色 + 关键词 -->
    <view class="fortune-meta">
      <view class="fortune-lucky" wx:if="{{luckyColor}}">
        <view class="lucky-dot" style="background-color: {{luckyColor.hex}};"></view>
        <text class="lucky-name">{{luckyColor.name}}</text>
      </view>
      <view class="fortune-keywords">
        <text class="keyword-tag" wx:for="{{keywords}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <!-- 分享按钮 -->
    <view class="fortune-share" bindtap="onShare">
      <text>分享给朋友</text>
    </view>
  </block>

  <!-- 未选类型 -->
  <block wx:else>
    <view class="fortune-prompt">
      <text class="prompt-text">选择你的 MBTI 类型，解锁每日签语</text>
      <view class="prompt-btn" bindtap="onGoSelect">
        <text>前往选择</text>
      </view>
    </view>
  </block>

  <!-- Loading 遮罩 -->
  <view class="fortune-loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
