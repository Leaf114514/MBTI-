<!--
  ========================================
  塔罗风格命运签语卡片组件
  用途：展示每日 MBTI 神谕签语，含装饰曼陀罗、幸运色、关键词等
  Props：
    · mbtiType    — 用户的 MBTI 类型（如 INTJ）
    · accentColor — 卡片的主题强调色（动态传入 CSS 变量）
    · accentRgb   — 卡片主题色的 RGB 分量值（用于 rgba() 透明度计算）
    · showPrompt  — 是否显示"前往选择"提示（未选类型时的牌背）
    · loading     — 是否处于加载中
    · loadError   — 是否加载失败
    · message     — 签语正文
    · keywords    — 关键词标签数组
    · dateNum     — 日期编号
    · luckyColor  — 幸运色对象 { hex, name }
  事件：
    · typeTap    → 点击 MBTI 类型区域
    · shareTap   → 点击分享按钮
    · onRetry    → 加载失败后重试
    · onGoSelect → 从牌背跳转选择页面
  ========================================
-->
<import src="/common/corner-decorations/decorations.wxml" />
<view class="fortune-card anim-phase-{{animPhase}} {{isLightAccent ? 'theme-dark' : ''}}" style="--accent: {{accentColor}}; --ar: {{accentRgb}};">
  <!-- 四角装饰（与卡背统一使用 corner-decorations 体系） -->
  <template is="corner-decorations" data="{{cornerDecor}}" />

  <!-- ================================================================ -->
  <!-- 牌面正面：已选 MBTI 类型时显示                                      -->
  <!-- ================================================================ -->
  <block wx:if="{{!showPrompt}}">
    <!-- ----- 牌名区：MBTI 类型 + 日期 + 幸运色 ----- -->
    <view class="card-title-area" bindtap="onTypeTap">
      <text class="card-name">{{mbtiType}}</text>
      <text class="card-number">{{dateNum}}</text>
      <!-- 幸运色（有色值时显示色块 + 名称） -->
      <view class="card-lucky" wx:if="{{luckyColor}}">
        <view class="lucky-dot" style="background-color: {{luckyColor.hex}};"></view>
        <text class="lucky-name">{{luckyColor.name}}</text>
      </view>
    </view>

    <!-- ----- 加载失败：显示错误提示 + 重试按钮 ----- -->
    <block wx:if="{{loadError}}">
      <view class="card-center">
        <text class="fortune-message fortune-error-text">签语加载失败，请稍后重试</text>
      </view>
      <view class="fortune-share" bindtap="onRetry">
        <text>重新加载</text>
      </view>
    </block>

    <!-- ----- 签语正文：多层动画结构 ----- -->
    <block wx:elif="{{message}}">
      <view class="card-center">
        <!-- Layer 0: 曼陀罗背景 -->
        <view class="card-mandala">
          <view class="mandala-outer"></view>
          <view class="mandala-ring"></view>
          <view class="mandala-inner"></view>
          <view class="mandala-cross"></view>
          <text class="mandala-type">{{mbtiType}}</text>
        </view>

        <!-- Layer 1: 大阿卡纳牌面 -->
        <view class="arcana-illustration" wx:if="{{arcanaCard}}">
          <view class="arcana-card-frame">
            <view class="arcana-shapes-wrap">
              <block wx:for="{{arcanaCard.shapes}}" wx:key="index">
                <view wx:if="{{item.type === 'circle'}}"
                  class="arcana-shape arcana-circle"
                  style="left:{{item.x - item.r}}rpx;top:{{item.y - item.r}}rpx;width:{{item.r * 2}}rpx;height:{{item.r * 2}}rpx;"></view>
                <view wx:if="{{item.type === 'line'}}"
                  class="arcana-shape arcana-line"
                  style="left:{{item.x1}}rpx;top:{{item.y1}}rpx;width:{{item.len}}rpx;transform:rotate({{item.angle}}deg);"></view>
                <view wx:if="{{item.type === 'rect'}}"
                  class="arcana-shape arcana-rect"
                  style="left:{{item.x}}rpx;top:{{item.y}}rpx;width:{{item.w}}rpx;height:{{item.h}}rpx;"></view>
              </block>
            </view>
            <text class="arcana-numeral">{{arcanaCard.numeral}}</text>
          </view>
        </view>

        <!-- Layer 2: 牌名（从上方坠落到分割线上方） -->
        <view class="arcana-name-area" wx:if="{{arcanaCard}}">
          <text class="arcana-name">{{arcanaCard.name}}</text>
        </view>

        <!-- Layer 3: 签语正文 -->
        <view class="fortune-message-wrap">
          <text class="fortune-quote-left">「</text>
          <text class="fortune-message">{{message}}</text>
          <text class="fortune-quote-right">」</text>
        </view>
      </view>

      <!-- ----- 底部解读区：关键词标签 ----- -->
      <view class="card-bottom">
        <!-- 菱形装饰分隔线 -->
        <view class="fortune-divider">✦</view>
        <!-- 关键词标签：横向排列居中 -->
        <view class="card-keywords">
          <text class="keyword-tag" wx:for="{{keywords}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </block>
  </block>

  <!-- ================================================================ -->
  <!-- 牌背：未选 MBTI 类型时显示                                           -->
  <!-- ================================================================ -->
  <block wx:else>
    <view class="card-back">
      <!-- 装饰纹样：同心双圆 + 中央问号 -->
      <view class="card-back-pattern">
        <view class="back-ring"></view>
        <view class="back-ring-inner"></view>
        <text class="back-symbol">?</text>
      </view>
      <text class="card-back-text">翻转你的命运之牌</text>
      <!-- "前往选择"引导按钮 -->
      <view class="prompt-btn" bindtap="onGoSelect">
        <text>前往选择</text>
      </view>
    </view>
  </block>

  <!-- ===== 全屏 Loading 遮罩 ===== -->
  <view class="fortune-loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
