@import "../../common/index.wxss";

/* ===== 信笺风签语卡片 ===== */
.fortune-card {
  width: 85%;
  margin: 0 auto;
  background-color: var(--color-bg-card);
  background-image: repeating-linear-gradient(
    to bottom,
    transparent,
    transparent 47rpx,
    rgba(0, 0, 0, 0.035) 47rpx,
    rgba(0, 0, 0, 0.035) 48rpx
  );
  border-radius: var(--radius-lg);
  border: 2rpx solid rgba(255, 107, 107, 0.3);
  box-shadow: var(--shadow-card);
  padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-md);
  position: relative;
  overflow: hidden;
}

/* 红色左边距线 */
.fortune-card::before {
  content: '';
  position: absolute;
  left: 60rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background-color: rgba(255, 107, 107, 0.18);
  z-index: 1;
}

/* 顶部装饰双线（红色调） */
.fortune-deco-top {
  margin-bottom: var(--spacing-lg);
  height: 4rpx;
  border-top: 1rpx solid rgba(255, 107, 107, 0.2);
  border-bottom: 1rpx solid rgba(255, 107, 107, 0.2);
}

/* 底部装饰双线（红色调） */
.fortune-deco-bottom {
  margin-top: var(--spacing-md);
  height: 4rpx;
  border-top: 1rpx solid rgba(255, 107, 107, 0.2);
  border-bottom: 1rpx solid rgba(255, 107, 107, 0.2);
}

/* 日期 */
.fortune-date {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-lg);
}

.fortune-date-text {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  letter-spacing: 4rpx;
}

.fortune-weekday {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
}

/* MBTI 徽章 — 红色信笺风 */
.fortune-type {
  display: inline-flex;
  padding: var(--spacing-xs) var(--spacing-lg);
  background: rgba(255, 107, 107, 0.06);
  border: 1rpx solid rgba(255, 107, 107, 0.2);
  border-radius: var(--radius-full);
  margin-bottom: var(--spacing-lg);
}

.fortune-type-text {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-primary);
  letter-spacing: 6rpx;
}

/* 签语内容 */
.fortune-message-wrap {
  display: flex;
  align-items: flex-start;
  margin-bottom: var(--spacing-lg);
  line-height: var(--line-height-relaxed);
}

.fortune-quote-left,
.fortune-quote-right {
  font-size: var(--font-size-title);
  color: var(--color-primary);
  opacity: 0.35;
  flex-shrink: 0;
  line-height: 1;
}

.fortune-quote-left {
  margin-right: var(--spacing-xs);
  margin-top: 6rpx;
}

.fortune-quote-right {
  margin-left: var(--spacing-xs);
  align-self: flex-end;
}

.fortune-message {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-relaxed);
  flex: 1;
}

.fortune-error-text {
  color: var(--color-text-tertiary);
}

/* 幸运色 + 关键词 */
.fortune-meta {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  flex-wrap: wrap;
}

.fortune-lucky {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

.lucky-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.lucky-name {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
}

.fortune-keywords {
  display: flex;
  gap: var(--spacing-xs);
  flex-wrap: wrap;
}

.keyword-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  background-color: rgba(255, 107, 107, 0.06);
  color: var(--color-primary);
  font-size: var(--font-size-micro);
  border-radius: var(--radius-full);
  border: 1rpx solid rgba(255, 107, 107, 0.12);
}

/* 花纹分隔线 */
.fortune-divider {
  display: flex;
  align-items: center;
  margin: var(--spacing-md) 0;
  color: var(--color-primary);
  font-size: 18rpx;
  opacity: 0.35;
}

.fortune-divider::before,
.fortune-divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: linear-gradient(to right, transparent, rgba(255, 107, 107, 0.2), transparent);
}

.fortune-divider::before {
  margin-right: var(--spacing-sm);
}

.fortune-divider::after {
  margin-left: var(--spacing-sm);
}

/* 分享按钮 — 红色调 */
.fortune-share {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border: 1rpx solid rgba(255, 107, 107, 0.3);
  border-radius: var(--radius-md);
  color: var(--color-primary);
  font-size: var(--font-size-caption);
  letter-spacing: 2rpx;
}

.fortune-share:active {
  opacity: 0.7;
  background-color: rgba(255, 107, 107, 0.04);
}

/* 未选提示 */
.fortune-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl) 0;
  gap: var(--spacing-lg);
}

.prompt-text {
  font-size: var(--font-size-body);
  color: var(--color-text-tertiary);
}

.prompt-btn {
  padding: var(--spacing-sm) var(--spacing-xl);
  background: rgba(255, 107, 107, 0.06);
  border: 1rpx solid rgba(255, 107, 107, 0.25);
  color: var(--color-primary);
  font-size: var(--font-size-body);
  border-radius: var(--radius-full);
  letter-spacing: 2rpx;
}

.prompt-btn:active {
  opacity: 0.9;
  background-color: rgba(255, 107, 107, 0.1);
}

/* Loading */
.fortune-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.7);
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}
