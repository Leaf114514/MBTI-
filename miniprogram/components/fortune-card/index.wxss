@import "../../common/index.wxss";
@import "../../common/corner-decorations/decorations.wxss";

/* ===== 塔罗神谕卡 ===== */
.fortune-card {
  --accent: #4A1942;
  --ar: 74,25,66;

  /* 组件级 CSS 变量兜底（page 作用域变量在组件重渲染时可能丢失继承） */
  --font-weight-bold: 700;
  --font-weight-medium: 500;
  --font-weight-regular: 400;
  --font-size-hero: 48rpx;
  --font-size-subtitle: 34rpx;
  --font-size-body: 28rpx;
  --font-size-caption: 24rpx;
  --font-size-micro: 20rpx;
  --color-text-primary: #1A1A1A;
  --color-text-secondary: #666666;
  --color-text-tertiary: #999999;
  --color-text-inverse: #FFFFFF;
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 40rpx;
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 50%;
  --line-height-tight: 1.3;
  --line-height-normal: 1.6;
  --line-height-relaxed: 1.8;

  width: 85%;
  height: 100%;
  margin: 0 auto;
  position: relative;
  display: flex;
  flex-direction: column;
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--accent);
  box-shadow: 0 4rpx 24rpx rgba(var(--ar), 0.15);
  padding: var(--spacing-xl);
  overflow: hidden;
  background: radial-gradient(
    circle at 50% 30%,
    #FFFFFF 0%,
    rgba(var(--ar), 0.03) 40%,
    rgba(var(--ar), 0.06) 100%
  );
  transition: border-color 1.5s ease, box-shadow 1.5s ease;
}

/* 内层边框 */
.fortune-card::after {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  border: 1rpx solid rgba(var(--ar), 0.15);
  border-radius: var(--radius-md);
  pointer-events: none;
  transition: border-color 1.5s ease;
}

/* ===== 牌名区 ===== */
.card-title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.card-name {
  font-size: var(--font-size-hero);
  font-weight: var(--font-weight-bold);
  color: var(--accent);
  letter-spacing: 12rpx;
  transition: color 1.5s ease;
}

.card-number {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  letter-spacing: 4rpx;
  margin-top: var(--spacing-xs);
}

/* 幸运色（日期下方居中） */
.card-lucky {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  margin-top: var(--spacing-sm);
}

.lucky-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.lucky-name {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
}

/* ===== 牌面中央 ===== */
.card-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 装饰曼陀罗 */
.card-mandala {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 360rpx;
  height: 360rpx;
}

.mandala-outer {
  position: absolute;
  top: -12rpx;
  left: -12rpx;
  right: -12rpx;
  bottom: -12rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(var(--ar), 0.10);
  transition: border-color 1.5s ease;
}

.mandala-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(var(--ar), 0.14);
  transition: border-color 1.5s ease;
}

.mandala-inner {
  position: absolute;
  top: 40rpx;
  left: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
  border-radius: 50%;
  border: 1rpx dashed rgba(var(--ar), 0.12);
  transition: border-color 1.5s ease;
}

/* 十字装饰线 */
.mandala-cross {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 100%;
  transform: translate(-50%, -50%) rotate(45deg);
}

.mandala-cross::before,
.mandala-cross::after {
  content: '';
  position: absolute;
  background-color: rgba(var(--ar), 0.08);
  transition: background-color 1.5s ease;
}

.mandala-cross::before {
  top: 0;
  bottom: 0;
  left: 50%;
  width: 1rpx;
  transform: translateX(-50%);
}

.mandala-cross::after {
  left: 0;
  right: 0;
  top: 50%;
  height: 1rpx;
  transform: translateY(-50%);
}

.mandala-type {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 100rpx;
  font-weight: var(--font-weight-bold);
  color: var(--accent);
  opacity: 0.08;
  letter-spacing: 16rpx;
  transition: color 1.5s ease;
}

/* 正文引号 */
.fortune-quote-left,
.fortune-quote-right {
  font-size: 56rpx;
  color: var(--accent);
  opacity: 0.4;
  flex-shrink: 0;
  line-height: 1;
  transition: color 1.5s ease;
}

.fortune-quote-left {
  margin-right: var(--spacing-xs);
  margin-top: 6rpx;
}

.fortune-quote-right {
  margin-left: var(--spacing-xs);
  align-self: flex-end;
}

.fortune-message-wrap {
  display: flex;
  align-items: flex-start;
  position: relative;
  z-index: 1;
}

.fortune-message {
  font-size: var(--font-size-subtitle);
  color: var(--color-text-primary);
  line-height: 2;
  flex: 1;
  font-weight: var(--font-weight-bold);
  text-align: center;
}

/* 正文区：翻牌动画 + 颜色过渡全部结束后渐显，完全避开 3D 上下文中的文字渲染 */
.fortune-message-wrap,
.card-bottom {
  opacity: 0;
  transition: opacity 0.5s ease 0.1s;
}

.fortune-card.content-visible .fortune-message-wrap,
.fortune-card.content-visible .card-bottom {
  opacity: 1;
}

.fortune-error-text {
  color: var(--color-text-tertiary);
  text-align: center;
}

/* ===== 底部解读区 ===== */
.card-bottom {
  flex-shrink: 0;
}

/* 菱形装饰分隔线（电影票风格渐隐） */
.fortune-divider {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-sm);
  color: var(--accent);
  font-size: 25rpx;
}

.fortune-divider::before,
.fortune-divider::after {
  content: '';
  flex: 1;
  height: 4rpx;
  border-radius: 2rpx;
}

.fortune-divider::before {
  margin-right: var(--spacing-sm);
  background: linear-gradient(90deg, transparent, var(--accent));
}

.fortune-divider::after {
  margin-left: var(--spacing-sm);
  background: linear-gradient(90deg, var(--accent), transparent);
}

/* 关键词居中 */
.card-keywords {
  display: flex;
  justify-content: center;
  gap: var(--spacing-xs);
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.keyword-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  background-color: rgba(var(--ar), 0.08);
  color: var(--accent);
  font-size: var(--font-size-micro);
  border-radius: var(--radius-full);
  border: 1rpx solid rgba(var(--ar), 0.18);
  transition: color 1.5s ease, background-color 1.5s ease, border-color 1.5s ease;
}

/* ===== 牌背 ===== */
.card-back {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-lg);
  position: relative;
}

.card-back-pattern {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.back-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 107, 107, 0.15);
}

.back-ring-inner {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  border-radius: 50%;
  border: 1rpx dashed rgba(255, 107, 107, 0.1);
}

.back-symbol {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 80rpx;
  font-weight: var(--font-weight-bold);
  color: rgba(255, 107, 107, 0.12);
}

.card-back-text {
  font-size: var(--font-size-body);
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
}

.prompt-btn {
  padding: var(--spacing-sm) var(--spacing-xl);
  background: rgba(255, 107, 107, 0.06);
  border: 1rpx solid rgba(255, 107, 107, 0.25);
  color: var(--color-primary);
  font-size: var(--font-size-body);
  border-radius: var(--radius-full);
  letter-spacing: 2rpx;
}

.prompt-btn:active {
  opacity: 0.9;
  background-color: rgba(255, 107, 107, 0.1);
}

/* Loading */
.fortune-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.7);
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  border-radius: var(--radius-lg);
}
