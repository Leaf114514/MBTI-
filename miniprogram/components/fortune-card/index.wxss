@import "../../common/index.wxss";
@import "../../common/corner-decorations/decorations.wxss";

/* ===== 塔罗神谕卡 ===== */
.fortune-card {
  --accent: #4A1942;
  --ar: 74,25,66;

  /* 组件级 CSS 变量兜底（page 作用域变量在组件重渲染时可能丢失继承） */
  --font-weight-bold: 700;
  --font-weight-medium: 500;
  --font-weight-regular: 400;
  --font-size-hero: 48rpx;
  --font-size-subtitle: 34rpx;
  --font-size-body: 28rpx;
  --font-size-caption: 24rpx;
  --font-size-micro: 20rpx;
  --color-text-primary: #1A1A1A;
  --color-text-secondary: #666666;
  --color-text-tertiary: #999999;
  --color-text-inverse: #FFFFFF;
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 40rpx;
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 50%;
  --line-height-tight: 1.3;
  --line-height-normal: 1.6;
  --line-height-relaxed: 1.8;

  width: 85%;
  height: 100%;
  margin: 0 auto;
  position: relative;
  display: flex;
  flex-direction: column;
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--accent);
  box-shadow: 0 4rpx 24rpx rgba(var(--ar), 0.15);
  padding: var(--spacing-xl);
  overflow: hidden;
  background: radial-gradient(
    circle at 50% 30%,
    #FFFFFF 0%,
    rgba(var(--ar), 0.03) 40%,
    rgba(var(--ar), 0.06) 100%
  );
  transition: border-color 1.5s ease, box-shadow 1.5s ease;
}

/* 内层边框 */
.fortune-card::after {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  border: 1rpx solid rgba(var(--ar), 0.15);
  border-radius: var(--radius-md);
  pointer-events: none;
  transition: border-color 1.5s ease;
}

/* ===== 牌名区 ===== */
.card-title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.card-name {
  font-size: var(--font-size-hero);
  font-weight: var(--font-weight-bold);
  color: var(--accent);
  letter-spacing: 12rpx;
  transition: color 1.5s ease;
}

.card-number {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  letter-spacing: 4rpx;
  margin-top: var(--spacing-xs);
}

/* 幸运色（日期下方居中） */
.card-lucky {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  margin-top: var(--spacing-sm);
}

.lucky-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.lucky-name {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
}

/* ===== 牌面中央 ===== */
.card-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 装饰曼陀罗 */
.card-mandala {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 360rpx;
  height: 360rpx;
}

.mandala-outer {
  position: absolute;
  top: -12rpx;
  left: -12rpx;
  right: -12rpx;
  bottom: -12rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(var(--ar), 0.10);
  transition: border-color 1.5s ease;
}

.mandala-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(var(--ar), 0.14);
  transition: border-color 1.5s ease;
}

.mandala-inner {
  position: absolute;
  top: 40rpx;
  left: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
  border-radius: 50%;
  border: 1rpx dashed rgba(var(--ar), 0.12);
  transition: border-color 1.5s ease;
}

/* 十字装饰线 */
.mandala-cross {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 100%;
  transform: translate(-50%, -50%) rotate(45deg);
}

.mandala-cross::before,
.mandala-cross::after {
  content: '';
  position: absolute;
  background-color: rgba(var(--ar), 0.08);
  transition: background-color 1.5s ease;
}

.mandala-cross::before {
  top: 0;
  bottom: 0;
  left: 50%;
  width: 1rpx;
  transform: translateX(-50%);
}

.mandala-cross::after {
  left: 0;
  right: 0;
  top: 50%;
  height: 1rpx;
  transform: translateY(-50%);
}

.mandala-type {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 100rpx;
  font-weight: var(--font-weight-bold);
  color: var(--accent);
  opacity: 0.08;
  letter-spacing: 16rpx;
  transition: color 1.5s ease;
}

/* 正文引号 */
.fortune-quote-left,
.fortune-quote-right {
  font-size: 56rpx;
  color: var(--accent);
  opacity: 0.4;
  flex-shrink: 0;
  line-height: 1;
  transition: color 1.5s ease;
}

.fortune-quote-left {
  margin-right: var(--spacing-xs);
  margin-top: 6rpx;
}

.fortune-quote-right {
  margin-left: var(--spacing-xs);
  align-self: flex-end;
}

.fortune-message-wrap {
  display: flex;
  align-items: flex-start;
  position: relative;
  z-index: 1;
}

.fortune-message {
  font-size: var(--font-size-subtitle);
  color: var(--color-text-primary);
  line-height: 2;
  flex: 1;
  font-weight: var(--font-weight-bold);
  text-align: center;
}

/* ===== 多阶段动画系统 ===== */

/* Phase 0: 所有动画层隐藏 */
.arcana-illustration {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 280rpx;
  height: 360rpx;
  z-index: 1;
  opacity: 0;
  transition: opacity 0.4s ease, transform 0.8s ease;
}

.arcana-name-area {
  position: absolute;
  bottom: -10rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 3;
  opacity: 0;
  transition: opacity 0.5s ease;
}

.fortune-message-wrap,
.card-bottom {
  opacity: 0;
  transition: opacity 0.5s ease;
}

/* Phase 1: 大阿卡纳牌面渐显 */
.anim-phase-1 .arcana-illustration {
  opacity: 1;
}

/* Phase 2: 牌名坠落 + 牌面淡出背景 */
@keyframes arcana-name-drop {
  0% {
    opacity: 0;
    transform: translateY(-60rpx);
  }
  40% {
    opacity: 1;
  }
  70% {
    transform: translateY(6rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.anim-phase-2 .arcana-illustration,
.anim-phase-3 .arcana-illustration,
.anim-phase-4 .arcana-illustration {
  opacity: 0.1;
  transform: translate(-50%, -50%) scale(0.92);
  transition: opacity 0.8s ease, transform 0.8s ease;
}

.anim-phase-2 .arcana-name-area,
.anim-phase-3 .arcana-name-area,
.anim-phase-4 .arcana-name-area {
  opacity: 1;
  animation: arcana-name-drop 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

/* Phase 2: 关键词 + 分割线渐显（与牌名坠落同步） */
.anim-phase-2 .card-bottom,
.anim-phase-3 .card-bottom,
.anim-phase-4 .card-bottom {
  opacity: 1;
}

/* Phase 3: 正文渐显 */
.anim-phase-3 .fortune-message-wrap,
.anim-phase-4 .fortune-message-wrap {
  opacity: 1;
}

/* ===== 大阿卡纳牌面样式 ===== */

.arcana-card-frame {
  width: 100%;
  height: 100%;
  border: 3rpx solid rgba(var(--ar), 0.35);
  border-radius: var(--radius-md);
  position: relative;
  overflow: hidden;
  background: radial-gradient(
    circle at 50% 40%,
    rgba(var(--ar), 0.06) 0%,
    transparent 60%
  );
}

.arcana-shapes-wrap {
  position: relative;
  width: 100%;
  height: 100%;
}

.arcana-shape {
  position: absolute;
  box-sizing: border-box;
}

.arcana-circle {
  border: 4rpx solid rgba(var(--ar), 0.55);
  border-radius: 50%;
}

.arcana-line {
  height: 4rpx;
  background-color: rgba(var(--ar), 0.5);
  transform-origin: 0 50%;
}

.arcana-rect {
  border: 4rpx solid rgba(var(--ar), 0.5);
  border-radius: 4rpx;
}

.arcana-numeral {
  position: absolute;
  bottom: 12rpx;
  right: 16rpx;
  font-size: 30rpx;
  color: rgba(var(--ar), 0.5);
  font-weight: var(--font-weight-bold);
}

/* ===== 牌名样式 ===== */

.arcana-name {
  font-size: 56rpx;
  font-weight: var(--font-weight-bold);
  color: var(--accent);
  letter-spacing: 20rpx;
  margin-right: -20rpx;
  text-shadow: 0 2rpx 16rpx rgba(var(--ar), 0.2);
  transition: color 1.5s ease;
}

.fortune-error-text {
  color: var(--color-text-tertiary);
  text-align: center;
}

/* ===== 底部解读区 ===== */
.card-bottom {
  flex-shrink: 0;
}

/* 菱形装饰分隔线（电影票风格渐隐） */
.fortune-divider {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-sm);
  color: var(--accent);
  font-size: 25rpx;
}

.fortune-divider::before,
.fortune-divider::after {
  content: '';
  flex: 1;
  height: 4rpx;
  border-radius: 2rpx;
}

.fortune-divider::before {
  margin-right: var(--spacing-sm);
  background: linear-gradient(90deg, transparent, var(--accent));
}

.fortune-divider::after {
  margin-left: var(--spacing-sm);
  background: linear-gradient(90deg, var(--accent), transparent);
}

/* 关键词居中 */
.card-keywords {
  display: flex;
  justify-content: center;
  gap: var(--spacing-xs);
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.keyword-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  background-color: rgba(var(--ar), 0.08);
  color: var(--accent);
  font-size: var(--font-size-micro);
  border-radius: var(--radius-full);
  border: 1rpx solid rgba(var(--ar), 0.18);
  transition: color 1.5s ease, background-color 1.5s ease, border-color 1.5s ease;
}

/* ===== 牌背 ===== */
.card-back {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-lg);
  position: relative;
}

.card-back-pattern {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.back-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 107, 107, 0.15);
}

.back-ring-inner {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  border-radius: 50%;
  border: 1rpx dashed rgba(255, 107, 107, 0.1);
}

.back-symbol {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 80rpx;
  font-weight: var(--font-weight-bold);
  color: rgba(255, 107, 107, 0.12);
}

.card-back-text {
  font-size: var(--font-size-body);
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
}

.prompt-btn {
  padding: var(--spacing-sm) var(--spacing-xl);
  background: rgba(255, 107, 107, 0.06);
  border: 1rpx solid rgba(255, 107, 107, 0.25);
  color: var(--color-primary);
  font-size: var(--font-size-body);
  border-radius: var(--radius-full);
  letter-spacing: 2rpx;
}

.prompt-btn:active {
  opacity: 0.9;
  background-color: rgba(255, 107, 107, 0.1);
}

/* Loading */
.fortune-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.7);
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  border-radius: var(--radius-lg);
}

/* ===== 暗色主题（浅色幸运色时自动启用） ===== */
/* 组件级兜底变量会覆盖继承的 .page-dark 值，需在此处显式重置 */

.theme-dark {
  --color-text-primary: #FFFFFF;
  --color-text-secondary: rgba(255, 255, 255, 0.65);
  --color-text-tertiary: rgba(255, 255, 255, 0.4);
  background: linear-gradient(
    180deg,
    var(--color-bg-card) 0%,
    rgba(var(--ar), 0.08) 40%,
    rgba(var(--ar), 0.12) 100%
  );
  border-color: rgba(var(--ar), 0.5);
}

.theme-dark::after {
  border-color: rgba(var(--ar), 0.2);
}

.theme-dark .fortune-quote-left,
.theme-dark .fortune-quote-right {
  color: var(--accent);
  opacity: 0.6;
}

.theme-dark .mandala-outer {
  border-color: rgba(var(--ar), 0.15);
}

.theme-dark .mandala-ring {
  border-color: rgba(var(--ar), 0.18);
}

.theme-dark .mandala-inner {
  border-color: rgba(var(--ar), 0.14);
}

.theme-dark .mandala-cross::before,
.theme-dark .mandala-cross::after {
  background-color: rgba(var(--ar), 0.12);
}

.theme-dark .mandala-type {
  color: var(--accent);
  opacity: 0.12;
}

.theme-dark .arcana-card-frame {
  border-color: rgba(var(--ar), 0.35);
  background: radial-gradient(
    circle at 50% 40%,
    rgba(var(--ar), 0.08) 0%,
    transparent 60%
  );
}

.theme-dark .fortune-loading {
  background-color: rgba(30, 30, 42, 0.7);
  color: var(--color-text-tertiary);
}
