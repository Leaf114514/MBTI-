/* ===== 卡背四角装饰样式 ===== */

/* 角装饰容器 */
.corner-deco {
  position: absolute;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  pointer-events: none;
}

/* 定位 */
.corner-deco-tl { top: 28rpx; left: 28rpx; }
.corner-deco-tr { top: 28rpx; right: 28rpx; }
.corner-deco-bl { bottom: 28rpx; left: 28rpx; }
.corner-deco-br { bottom: 28rpx; right: 28rpx; }

/* L 形圆弧边框：利用单边 border + border-radius 实现弧形角 */
.corner-frame {
  position: absolute;
  width: 100%;
  height: 100%;
}

/* 左上：上边 + 左边，左上角圆弧 */
.corner-frame-tl {
  border-top: 2rpx solid rgba(var(--color-back-pink), 0.2);
  border-left: 2rpx solid rgba(var(--color-back-pink), 0.2);
  border-top-left-radius: 12rpx;
}

/* 右上：上边 + 右边，右上角圆弧 */
.corner-frame-tr {
  border-top: 2rpx solid rgba(var(--color-back-pink), 0.2);
  border-right: 2rpx solid rgba(var(--color-back-pink), 0.2);
  border-top-right-radius: 12rpx;
}

/* 左下：下边 + 左边，左下角圆弧 */
.corner-frame-bl {
  border-bottom: 2rpx solid rgba(var(--color-back-pink), 0.2);
  border-left: 2rpx solid rgba(var(--color-back-pink), 0.2);
  border-bottom-left-radius: 12rpx;
}

/* 右下：下边 + 右边，右下角圆弧 */
.corner-frame-br {
  border-bottom: 2rpx solid rgba(var(--color-back-pink), 0.2);
  border-right: 2rpx solid rgba(var(--color-back-pink), 0.2);
  border-bottom-right-radius: 12rpx;
}

/* 中央装饰符号 */
.corner-sym {
  font-size: 18rpx;
  color: rgba(var(--color-back-pink), 0.3);
  z-index: 1;
}
