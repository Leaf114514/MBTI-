<!--
  ========================================
  卡背四角装饰模板（corner-decorations）
  用途：在卡背四角显示统一装饰图案（L 形圆弧框 + 符号）
  数据绑定：
    · {{cornerDecor}} — 由 decorations.js 的 getCornerDecor() 随机生成
        含 sym（四角统一的装饰符号），为 null 时不渲染
  ========================================
-->
<template name="corner-decorations">
  <block wx:if="{{cornerDecor}}">
    <!-- 左上角 -->
    <view class="corner-deco corner-deco-tl">
      <view class="corner-frame corner-frame-tl"></view>
      <text class="corner-sym">{{cornerDecor.sym}}</text>
    </view>
    <!-- 右上角 -->
    <view class="corner-deco corner-deco-tr">
      <view class="corner-frame corner-frame-tr"></view>
      <text class="corner-sym">{{cornerDecor.sym}}</text>
    </view>
    <!-- 左下角 -->
    <view class="corner-deco corner-deco-bl">
      <view class="corner-frame corner-frame-bl"></view>
      <text class="corner-sym">{{cornerDecor.sym}}</text>
    </view>
    <!-- 右下角 -->
    <view class="corner-deco corner-deco-br">
      <view class="corner-frame corner-frame-br"></view>
      <text class="corner-sym">{{cornerDecor.sym}}</text>
    </view>
  </block>
</template>
