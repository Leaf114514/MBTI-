/* ===== 星座绘制模板样式 ===== */

/* 星座绘制容器：覆盖卡片，不影响其他元素 */
.constellation-draw {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

/* ----- 连线 ----- */
.const-line {
  position: absolute;
  height: 1rpx;
  background-color: rgba(255, 180, 180, 0.18);
  transform-origin: 0 50%;
}

/* ----- 星星（普通） ----- */
.const-star {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  margin-left: -3rpx;
  margin-top: -3rpx;
  border-radius: 50%;
  background-color: rgba(255, 200, 200, 0.35);
}

/* ----- 星星（主星，更亮更大） ----- */
.const-star-big {
  width: 10rpx;
  height: 10rpx;
  margin-left: -5rpx;
  margin-top: -5rpx;
  background-color: rgba(255, 180, 180, 0.6);
  box-shadow: 0 0 8rpx rgba(255, 160, 160, 0.3);
}

/* ----- 星座名标签 ----- */
.const-label {
  position: absolute;
  transform: translateX(-50%);
}

.const-label-text {
  font-size: 16rpx;
  color: rgba(255, 180, 180, 0.22);
  letter-spacing: 2rpx;
  white-space: nowrap;
}
