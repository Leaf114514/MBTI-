.index-hd {
  padding: 40px;
  text-align: center;
}
.index-bd {
  padding: 0 15px 20px;
}
.index-ft {
  padding-bottom: 10px;
  text-align: center;
}
.index-logo {
  width: 43px;
  height: 43px;
}
.index-desc {
  margin-top: 10px;
  color: #888888;
  font-size: 14px;
}


.navigator-box {
  opacity: 0;
  position: relative;
  background-color: #FFFFFF;
  line-height: 1.41176471;
  font-size: 32px;

  transform: translateY(-50%);
  transition: .3s;
}
.navigator-box-show {
  opacity: 1;
  transform: translateY(0);
}
.navigator {
  padding: 10px 15px;
  position: relative;
  display: flex;
  align-items: center;
}
.navigator:before {
  content: " ";
  position: absolute;
  left: 15px;
  top: 0;
  right: 15px;
  height: 1px;
  border-top: 1px solid #D8D8D8;
  color: #D8D8D8;
}
.navigator:first-child:before {
  display: none;
}
.navigator-text {
  flex: 1;
}
.navigator-arrow {
  padding-right: 13px;
  position: relative;
}
.navigator-arrow:after {
  content: " ";
  display: inline-block;
  height: 9px;
  width: 9px;
  border-width: 1px 1px 0 0;
  border-color: #888888;
  border-style: solid;
  transform: matrix(0.71, 0.71, -0.71, 0.71, 0, 0);
  position: absolute;
  top: 50%;
  margin-top: -4px;
  right: 14px;
}


.kind-list-item {
  margin: 10px 0;
  background-color: #FFFFFF;
  border-radius: 2px;
  overflow: hidden;
}
.kind-list-item:first-child {
  margin-top: 0;
}
.kind-list-text{
  flex: 1;
}
.kind-list-img {
  width: 30px;
  height: 30px;
}
.kind-list-item-hd {
  padding: 15px;
  display: flex;
  align-items: center;

  transition: opacity .3s;
}
.kind-list-item-hd-show {
  opacity: .2;
}
.kind-list-item-bd {
  height: 0;
  overflow: hidden;
}
.kind-list-item-bd-show {
  height: auto;
}

 /* 在这里引入了各种可以调用的wxss参数，内容预复制小叶子的预设计，有略微修改 */
/* ===== 颜色系统 ===== */
page {
  background-color: #FFFBFB;

  /* 主色 */
  --color-primary: #FF6B6B;
  --color-primary-rgb: 255, 107, 107;
  --color-primary-light: #FF8E8E;
  --color-primary-dark: #E85555;

  /* 辅助色 */
  --color-accent-teal: #4ECDC4;
  --color-accent-yellow: #FFD166;
  --color-accent-purple: #A78BFA;

  /* 中性色 */
  --color-text-primary: #1A1A1A;
  --color-text-secondary: #666666;
  --color-text-tertiary: #999999;
  --color-text-inverse: #FFFFFF;

  /* 背景色 */
  --color-bg-page: transparent;
  --color-bg-card: #FFFFFF;
  --color-bg-input: #F1F3F5;

  /* 边框与分割 */
  --color-border: #E8ECF0;
  --color-divider: #F0F0F0;

  /* 语义色 */
  --color-success: #4ECDC4;
  --color-warning: #FFD166;
  --color-error: #FF6B6B;

  /* ===== 字体系统 ===== */
  --font-size-hero: 48rpx;
  --font-size-title: 40rpx;
  --font-size-subtitle: 34rpx;
  --font-size-body: 28rpx;
  --font-size-caption: 24rpx;
  --font-size-micro: 20rpx;

  --font-weight-bold: 700;
  --font-weight-medium: 500;
  --font-weight-regular: 400;

  --line-height-tight: 1.3;
  --line-height-normal: 1.6;
  --line-height-relaxed: 1.8;

  /* ===== 间距系统 ===== */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 40rpx;
  --spacing-2xl: 48rpx;
  --spacing-3xl: 64rpx;

  /* ===== 圆角系统 ===== */
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 50%;

  /* ===== 阴影系统 ===== */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  --shadow-card: 0 4rpx 24rpx rgba(31, 42, 55, 0.08);

  /* ===== 动画参数 ===== */
  --duration-fast: 150ms;
  --duration-normal: 250ms;
  --duration-slow: 400ms;
  --ease-out: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

  /* ===== 卡背装饰色（星座连线/四角边框/星芒等暗红粉调） ===== */
  /* 使用 raw RGB 分量，方便通过 rgba(var(--xxx), alpha) 灵活控制透明度 */
  --color-back-pink: 255, 180, 180;       /* 基础粉 — 连线、边框 */
  --color-back-pink-light: 255, 200, 200; /* 浅粉 — 普通星星 */
  --color-back-pink-deep: 255, 160, 160;  /* 深粉 — 主星高亮 / 星芒 */
}

/* ===== 暗色主题覆盖（浅色幸运色时通过 .page-dark 启用） ===== */
.page-dark {
  background: #1A1A28;
  --color-bg-page: #1A1A28;
  --color-bg-card: #2A2A3A;
  --color-bg-input: #2A2A3A;
  --color-text-primary: #FFFFFF;
  --color-text-secondary: rgba(255, 255, 255, 0.65);
  --color-text-tertiary: rgba(255, 255, 255, 0.4);
  --color-border: rgba(255, 255, 255, 0.1);
  --color-divider: rgba(255, 255, 255, 0.06);
  --shadow-card: 0 4rpx 24rpx rgba(0, 0, 0, 0.25);
}

/* 浅色幸运色时按钮背景偏浅，文字改为深色以保证可读性 */
.page-dark .btn-primary,
.page-dark .picker-confirm-btn {
  color: #1A1A1A;
}

/* ===== 掉落几何图形（通用） ===== */
.shapes-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
  transition: opacity 0.3s ease;
}

.shapes-hidden {
  opacity: 0;
}

.shape {
  position: absolute;
  top: -60rpx;
}

.shape-square {
  border-radius: 4rpx;
}

.shape-circle {
  border-radius: 50%;
}

.shape-diamond {
  border-radius: 4rpx;
  transform: rotate(45deg);
}

@keyframes shape-fall {
  0% {
    transform: translateY(-60rpx) rotate(0deg);
    opacity: 0;
  }
  5% {
    opacity: 1;
  }
  85% {
    opacity: 1;
  }
  100% {
    transform: translateY(110vh) rotate(540deg);
    opacity: 0;
  }
}

/* ===== 地图切换按钮（左上角圆形） ===== */
.toggle-btn {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  box-shadow: 0 4rpx 16rpx rgba(var(--color-primary-rgb), 0.35);
  z-index: 10;
}

.toggle-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

@keyframes toggle-shake {
  0%, 100% { transform: translateX(0); }
  15%, 55%, 85% { transform: translateX(-4rpx); }
  35%, 75% { transform: translateX(4rpx); }
}

.toggle-shake {
  animation: toggle-shake 0.4s ease-in-out;
}

/* ===== 展开/收起动画 ===== */
@keyframes expand-in {
  from { max-height: 0; opacity: 0; }
  to { max-height: 500rpx; opacity: 1; }
}

@keyframes expand-out {
  from { max-height: 500rpx; opacity: 1; }
  to { max-height: 0; opacity: 0; }
}

/* ===== 抖动动画 ===== */
@keyframes btn-shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-10rpx); }
  40% { transform: translateX(10rpx); }
  60% { transform: translateX(-6rpx); }
  80% { transform: translateX(6rpx); }
}

.anim-shake {
  animation: btn-shake 0.4s ease-out;
}

/* ===== 主按钮（红色渐变） ===== */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background-color: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-md);
  transition: all var(--duration-fast) var(--ease-out);
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-primary.disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* ===== 选择器确认按钮（略矮版本） ===== */
.picker-confirm-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  background-color: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-sm);
}
